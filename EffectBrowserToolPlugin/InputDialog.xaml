<Window x:Class="EffectBrowserToolPlugin.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="入力" Height="150" Width="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <TextBlock x:Name="MessageText" Grid.Row="0" Margin="0,0,0,8" Text="値を入力してください:" TextWrapping="Wrap" />
        <TextBox x:Name="InputTextBox" Grid.Row="1" Margin="0,0,0,12" VerticalContentAlignment="Center" KeyDown="InputTextBox_KeyDown" />
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="確定" Width="70" Margin="0,0,8,0" Click="OkButton_Click" IsDefault="True" />
            <Button Content="キャンセル" Width="70" Click="CancelButton_Click" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>

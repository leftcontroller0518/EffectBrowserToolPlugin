<UserControl x:Class="EffectBrowserToolPlugin.EffectBrowserToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:EffectBrowserToolPlugin"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:EffectBrowserToolViewModel}"
             MinWidth="320" MinHeight="420">

    <UserControl.Resources>
        <ResourceDictionary>
            <!-- 共有右クリックメニュー -->
            <ContextMenu x:Key="EffectItemContextMenu">
                <MenuItem Header="検索ワードを設定..." Click="SetCustomKeywords_Click" Tag="{Binding}" />
                <MenuItem Header="パラメータ付きプリセットとして保存..." Click="SaveAsPreset_Click" Tag="{Binding}" />
                <MenuItem Header="フォルダに追加..." Click="AddToFolder_Click" Tag="{Binding}" />
                <Separator />
                <MenuItem Header="お気に入りを切り替え" Click="ToggleFavoriteButton_Click" Tag="{Binding}" />
            </ContextMenu>

            <!-- リストアイテム表示テンプレート（標準用） -->
            <DataTemplate x:Key="EffectListItemTemplate" DataType="{x:Type local:EffectEntry}">
                <Border Margin="2,2,2,4"
                        Padding="8,6"
                        CornerRadius="4"
                        Background="#1A808080"
                        BorderBrush="#33808080"
                        BorderThickness="1"
                        Cursor="Hand"
                        MouseLeftButtonDown="EffectItem_MouseLeftButtonDown"
                        ContextMenu="{StaticResource EffectItemContextMenu}"
                        ToolTip="{Binding ToolTipDescription}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#3D007ACC" />
                                    <Setter Property="BorderBrush" Value="#88007ACC" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- お気に入り ⭐ ボタン -->
                        <Button Grid.Column="0"
                                Content="{Binding FavoriteStarIcon}"
                                Foreground="{Binding FavoriteStarColor}"
                                FontSize="14"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="4,0,8,0"
                                VerticalAlignment="Center"
                                Click="ToggleFavoriteButton_Click"
                                Tag="{Binding}" />

                        <!-- 中央：名前とサブ名 -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="🏷️" FontSize="10" Margin="4,0,0,0" Visibility="{Binding HasCustomKeywords, Converter={x:Static local:EffectBrowserToolView.BooleanToVisibilityConverter}}" ToolTip="{Binding CustomKeywords}" />
                            </Grid>
                            <TextBlock Text="{Binding SubText}"
                                       FontSize="10"
                                       Opacity="0.6"
                                       Margin="0,1,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Button Grid.Column="2"
                                Content="適用"
                                FontSize="11"
                                Padding="8,2"
                                VerticalAlignment="Center"
                                Click="ApplyButton_Click"
                                Tag="{Binding}" />
                    </Grid>
                </Border>
            </DataTemplate>

            <!-- 検索・お気に入りリスト等用（種別バッジ＋カテゴリ付きテンプレート） -->
            <DataTemplate x:Key="RichListItemTemplate" DataType="{x:Type local:EffectEntry}">
                <Border Margin="2,2,2,4"
                        Padding="8,6"
                        CornerRadius="4"
                        Background="#1A808080"
                        BorderBrush="#33808080"
                        BorderThickness="1"
                        Cursor="Hand"
                        MouseLeftButtonDown="EffectItem_MouseLeftButtonDown"
                        ContextMenu="{StaticResource EffectItemContextMenu}"
                        ToolTip="{Binding ToolTipDescription}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#3D007ACC" />
                                    <Setter Property="BorderBrush" Value="#88007ACC" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- お気に入り ⭐ ボタン -->
                        <Button Grid.Column="0"
                                Content="{Binding FavoriteStarIcon}"
                                Foreground="{Binding FavoriteStarColor}"
                                FontSize="14"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="4,0,6,0"
                                VerticalAlignment="Center"
                                Click="ToggleFavoriteButton_Click"
                                Tag="{Binding}" />

                        <!-- 種別バッジ (映像: 青系 / 音声: オレンジ系) -->
                        <Border Grid.Column="1"
                                Margin="0,0,8,0"
                                Padding="5,2"
                                CornerRadius="3"
                                VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#2A007ACC" />
                                    <Setter Property="BorderBrush" Value="#66007ACC" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="Audio">
                                            <Setter Property="Background" Value="#2AE67E22" />
                                            <Setter Property="BorderBrush" Value="#66E67E22" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding KindText}"
                                       FontSize="9.5"
                                       FontWeight="Bold" />
                        </Border>

                        <!-- エフェクト名とサブテキスト -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="🏷️" FontSize="10" Margin="4,0,0,0" Visibility="{Binding HasCustomKeywords, Converter={x:Static local:EffectBrowserToolView.BooleanToVisibilityConverter}}" ToolTip="{Binding CustomKeywords}" />
                            </Grid>
                            <TextBlock Text="{Binding SubText}"
                                       FontSize="10"
                                       Opacity="0.6"
                                       Margin="0,1,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- カテゴリタグ -->
                        <TextBlock Grid.Column="3"
                                   Text="{Binding Category}"
                                   FontSize="11"
                                   Opacity="0.5"
                                   VerticalAlignment="Center"
                                   Margin="8,0,8,0" />

                        <Button Grid.Column="4"
                                Content="適用"
                                FontSize="11"
                                Padding="8,2"
                                VerticalAlignment="Center"
                                Click="ApplyButton_Click"
                                Tag="{Binding}" />
                    </Grid>
                </Border>
            </DataTemplate>

            <!-- カテゴリグループテンプレート -->
            <DataTemplate x:Key="CategoryGroupTemplate" DataType="{x:Type local:EffectCategoryGroup}">
                <Expander Header="{Binding HeaderText}"
                          IsExpanded="True"
                          Margin="2,2,2,6"
                          FontWeight="Bold">
                    <ItemsControl ItemsSource="{Binding Effects}"
                                  ItemTemplate="{StaticResource EffectListItemTemplate}"
                                  Margin="4,4,2,6">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Expander>
            </DataTemplate>

            <!-- 適用中エフェクト管理用アイテムテンプレート -->
            <DataTemplate x:Key="ActiveEffectItemTemplate" DataType="{x:Type local:ActiveEffectViewModel}">
                <Border Margin="2,2,2,4"
                        Padding="8,6"
                        CornerRadius="4"
                        Background="#1A808080"
                        BorderBrush="#33808080"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <!-- 有効/無効スイッチ -->
                        <CheckBox Grid.Column="0" 
                                  IsChecked="{Binding IsEnabled}" 
                                  VerticalAlignment="Center" 
                                  Margin="4,0,8,0" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="{Binding TypeFullName}" FontSize="9.5" Opacity="0.5" />
                        </StackPanel>

                        <!-- 削除ボタン -->
                        <Button Grid.Column="2" 
                                Content="🗑️" 
                                Background="Transparent" 
                                BorderThickness="0" 
                                FontSize="12"
                                VerticalAlignment="Center" 
                                Click="DeleteActiveEffectButton_Click" 
                                Tag="{Binding}"
                                ToolTip="このエフェクトを削除" />
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel>

        <!-- ヘッダー：タイトルと更新ボタン -->
        <DockPanel DockPanel.Dock="Top" Margin="8,6,8,4" LastChildFill="False">
            <TextBlock Text="エフェクト一覧" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" DockPanel.Dock="Left" />
            <Button Content="更新"
                    Width="64"
                    Padding="4,2"
                    DockPanel.Dock="Right"
                    Click="RefreshButton_Click" />
        </DockPanel>

        <!-- フッター：ステータスバー -->
        <Border DockPanel.Dock="Bottom"
                Margin="4,2,4,4"
                Padding="6,4"
                Background="#10808080"
                CornerRadius="3">
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="11"
                       Opacity="0.8"
                       TextTrimming="CharacterEllipsis" />
        </Border>

        <!-- メインタブ（8タブに拡張） -->
        <TabControl Margin="4" SelectedIndex="{Binding SelectedTabIndex}">

            <!-- 1. 映像 -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="映像" />
                        <TextBlock Text="{Binding VideoEffectCount, StringFormat=' ({0})'}" FontSize="10" Opacity="0.6" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              Padding="2">
                    <ItemsControl ItemsSource="{Binding VideoEffectGroups}"
                                  ItemTemplate="{StaticResource CategoryGroupTemplate}" />
                </ScrollViewer>
            </TabItem>

            <!-- 2. 音声 -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="音声" />
                        <TextBlock Text="{Binding AudioEffectCount, StringFormat=' ({0})'}" FontSize="10" Opacity="0.6" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              Padding="2">
                    <ItemsControl ItemsSource="{Binding AudioEffectGroups}"
                                  ItemTemplate="{StaticResource CategoryGroupTemplate}" />
                </ScrollViewer>
            </TabItem>

            <!-- 3. お気に入り -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="お気に入り" />
                        <TextBlock Text="{Binding FavoriteEffectCount, StringFormat=' ({0})'}" FontSize="10" Opacity="0.6" />
                    </StackPanel>
                </TabItem.Header>
                <DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  Padding="2">
                        <ItemsControl ItemsSource="{Binding FavoriteEffects}"
                                      ItemTemplate="{StaticResource RichListItemTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="お気に入りに登録されたエフェクトはありません"
                               FontSize="12" Opacity="0.5"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="0,20,0,0"
                               Visibility="{Binding HasFavoriteEffects, Converter={x:Static local:EffectBrowserToolView.InverseBooleanToVisibilityConverter}}" />
                </DockPanel>
            </TabItem>

            <!-- 4. 履歴 -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="履歴" />
                        <TextBlock Text="{Binding RecentEffectCount, StringFormat=' ({0})'}" FontSize="10" Opacity="0.6" />
                    </StackPanel>
                </TabItem.Header>
                <DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  Padding="2">
                        <ItemsControl ItemsSource="{Binding RecentEffects}"
                                      ItemTemplate="{StaticResource RichListItemTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="最近使用したエフェクトはありません"
                               FontSize="12" Opacity="0.5"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="0,20,0,0"
                               Visibility="{Binding HasRecentEffects, Converter={x:Static local:EffectBrowserToolView.InverseBooleanToVisibilityConverter}}" />
                </DockPanel>
            </TabItem>

            <!-- 5. フォルダ -->
            <TabItem Header="フォルダ">
                <DockPanel Margin="4">
                    <ComboBox DockPanel.Dock="Top" 
                              ItemsSource="{Binding CustomTagNames}" 
                              SelectedItem="{Binding SelectedCustomTag}"
                              Margin="0,0,0,6" 
                              Padding="4" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding CustomTagEffects}"
                                      ItemTemplate="{StaticResource RichListItemTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- 6. プリセット -->
            <TabItem Header="プリセット">
                <DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="2">
                    <ItemsControl ItemsSource="{Binding Presets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:PresetModel}">
                                <Border Margin="2,2,2,4" Padding="10,6" CornerRadius="4" Background="#1A808080" BorderBrush="#33808080" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="{Binding TargetEffectTypeFullName}" FontSize="9.5" Opacity="0.5" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="適用" FontSize="11" Padding="8,2" Click="ApplyPresetButton_Click" Tag="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                    <TextBlock Text="保存されたプリセットはありません"
                               FontSize="12" Opacity="0.5"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="0,20,0,0"
                               Visibility="{Binding HasPresets, Converter={x:Static local:EffectBrowserToolView.InverseBooleanToVisibilityConverter}}" />
                </DockPanel>
            </TabItem>

            <!-- 7. 適用中 -->
            <TabItem Header="適用中">
                <DockPanel Margin="4">
                    <Button DockPanel.Dock="Top" Content="選択中アイテムのエフェクトを取得" Margin="0,0,0,6" Padding="6" Click="GetActiveEffectsButton_Click" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SelectedItemsEffects}" ItemTemplate="{StaticResource ActiveEffectItemTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- 8. 検索 -->
            <TabItem Header="検索">
                <DockPanel Margin="4">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchInputBox"
                                 Grid.Column="0"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="6,4,24,4"
                                 VerticalContentAlignment="Center"
                                 FontSize="12" />
                        <!-- プレースホルダー -->
                        <TextBlock Grid.Column="0"
                                   Text="エフェクト名で検索..."
                                   FontSize="12"
                                   Foreground="#80FFFFFF"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding HasSearchQuery, Converter={x:Static local:EffectBrowserToolView.InverseBooleanToVisibilityConverter}}" />
                        <Button Grid.Column="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Width="18" Height="18"
                                Margin="0,0,4,0"
                                Background="Transparent"
                                BorderThickness="0"
                                Content="❌"
                                FontSize="9"
                                Click="ClearSearchButton_Click"
                                Visibility="{Binding HasSearchQuery, Converter={x:Static local:EffectBrowserToolView.BooleanToVisibilityConverter}}" />
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SearchResults}"
                                      ItemTemplate="{StaticResource RichListItemTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                    <!-- 検索結果が空の場合 -->
                    <TextBlock Text="該当するエフェクトが見つかりません"
                               FontSize="12" Opacity="0.5"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="0,20,0,0"
                               Visibility="{Binding HasSearchResults, Converter={x:Static local:EffectBrowserToolView.InverseBooleanToVisibilityConverter}}" />
                </DockPanel>
            </TabItem>

        </TabControl>

    </DockPanel>

</UserControl>
